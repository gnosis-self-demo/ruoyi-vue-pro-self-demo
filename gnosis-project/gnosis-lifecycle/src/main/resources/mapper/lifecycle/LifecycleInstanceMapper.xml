<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lifecycle.repository.LifecycleInstanceMapper">

    <resultMap id="BaseResultMap" type="lifecycle.domain.LifecycleInstance">
        <id column="id" property="id"/>
        <result column="business_type_id" property="businessTypeId"/>
        <result column="business_id" property="businessId"/>
        <result column="current_state_id" property="currentStateId"/>
        <result column="status" property="status"/>
        <result column="started_at" property="startedAt"/>
        <result column="finished_at" property="finishedAt"/>
        <result column="final_state_id" property="finalStateId"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, business_type_id, business_id, current_state_id, status, started_at, finished_at, final_state_id,
        create_user_id, update_user_id, create_time, update_time
    </sql>

    <select id="selectById" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lifecycle_instance
        WHERE id = #{id}
    </select>

    <select id="selectByBusinessId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lifecycle_instance
        WHERE business_type_id = #{param1} AND business_id = #{param2}
    </select>

    <select id="selectList" parameterType="lifecycle.domain.LifecycleInstance" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lifecycle_instance
        <where>
            <if test="businessTypeId != null and businessTypeId != ''">
                AND business_type_id = #{businessTypeId}
            </if>
            <if test="businessId != null and businessId != ''">
                AND business_id = #{businessId}
            </if>
            <if test="currentStateId != null and currentStateId != ''">
                AND current_state_id = #{currentStateId}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="finalStateId != null and finalStateId != ''">
                AND final_state_id = #{finalStateId}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="lifecycle.domain.LifecycleInstance">
        INSERT INTO lifecycle_instance (
            id, business_type_id, business_id, current_state_id, status,
            started_at, finished_at, final_state_id,
            create_user_id, update_user_id, create_time, update_time
        ) VALUES (
            #{id}, #{businessTypeId}, #{businessId}, #{currentStateId}, #{status},
            #{startedAt}, #{finishedAt}, #{finalStateId},
            #{createUserId}, #{updateUserId}, #{createTime}, #{updateTime}
        )
    </insert>

    <update id="updateById" parameterType="lifecycle.domain.LifecycleInstance">
        UPDATE lifecycle_instance
        <set>
            <if test="currentStateId != null and currentStateId != ''">
                current_state_id = #{currentStateId},
            </if>
            <if test="status != null and status != ''">
                status = #{status},
            </if>
            <if test="startedAt != null">
                started_at = #{startedAt},
            </if>
            <if test="finishedAt != null">
                finished_at = #{finishedAt},
            </if>
            <if test="finalStateId != null and finalStateId != ''">
                final_state_id = #{finalStateId},
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                update_user_id = #{updateUserId},
            </if>
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.String">
        DELETE FROM lifecycle_instance WHERE id = #{id}
    </delete>

    <delete id="deleteByIds" parameterType="java.lang.String">
        DELETE FROM lifecycle_instance WHERE id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
