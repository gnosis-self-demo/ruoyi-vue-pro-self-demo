<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gnosis.lifecycle.repository.LifecycleStateMapper">

    <resultMap id="BaseResultMap" type="com.gnosis.lifecycle.domain.LifecycleState">
        <id column="id" property="id"/>
        <result column="business_type_id" property="businessTypeId"/>
        <result column="state_name" property="stateName"/>
        <result column="state_code" property="stateCode"/>
        <result column="state_type" property="stateType"/>
        <result column="is_final_state" property="isFinalState"/>
        <result column="position_x" property="positionX"/>
        <result column="position_y" property="positionY"/>
        <result column="metadata" property="metadata"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, business_type_id, state_name, state_code, state_type, is_final_state, position_x, position_y, metadata,
        create_user_id, update_user_id, create_time, update_time
    </sql>

    <select id="selectById" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lifecycle_state
        WHERE id = #{id}
    </select>

    <select id="selectByBusinessTypeId" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lifecycle_state
        WHERE business_type_id = #{businessTypeId}
        ORDER BY state_type, state_code
    </select>

    <select id="selectList" parameterType="com.gnosis.lifecycle.domain.LifecycleState" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lifecycle_state
        <where>
            <if test="businessTypeId != null and businessTypeId != ''">
                AND business_type_id = #{businessTypeId}
            </if>
            <if test="stateName != null and stateName != ''">
                AND state_name LIKE CONCAT('%', #{stateName}, '%')
            </if>
            <if test="stateCode != null and stateCode != ''">
                AND state_code = #{stateCode}
            </if>
            <if test="stateType != null and stateType != ''">
                AND state_type = #{stateType}
            </if>
            <if test="isFinalState != null">
                AND is_final_state = #{isFinalState}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="com.gnosis.lifecycle.domain.LifecycleState">
        INSERT INTO lifecycle_state (
            id, business_type_id, state_name, state_code, state_type, is_final_state,
            position_x, position_y, metadata,
            create_user_id, update_user_id, create_time, update_time
        ) VALUES (
            #{id}, #{businessTypeId}, #{stateName}, #{stateCode}, #{stateType}, #{isFinalState},
            #{positionX}, #{positionY}, #{metadata},
            #{createUserId}, #{updateUserId}, #{createTime}, #{updateTime}
        )
    </insert>

    <update id="updateById" parameterType="com.gnosis.lifecycle.domain.LifecycleState">
        UPDATE lifecycle_state
        <set>
            <if test="stateName != null and stateName != ''">
                state_name = #{stateName},
            </if>
            <if test="stateCode != null and stateCode != ''">
                state_code = #{stateCode},
            </if>
            <if test="stateType != null and stateType != ''">
                state_type = #{stateType},
            </if>
            <if test="isFinalState != null">
                is_final_state = #{isFinalState},
            </if>
            <if test="positionX != null">
                position_x = #{positionX},
            </if>
            <if test="positionY != null">
                position_y = #{positionY},
            </if>
            <if test="metadata != null">
                metadata = #{metadata},
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                update_user_id = #{updateUserId},
            </if>
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.String">
        DELETE FROM lifecycle_state WHERE id = #{id}
    </delete>

    <delete id="deleteByIds" parameterType="java.lang.String">
        DELETE FROM lifecycle_state WHERE id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteByBusinessTypeId" parameterType="java.lang.String">
        DELETE FROM lifecycle_state WHERE business_type_id = #{businessTypeId}
    </delete>

    <select id="selectByCodeAndBusinessTypeId" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lifecycle_state
        WHERE state_code = #{stateCode}
        AND business_type_id = #{businessTypeId}
    </select>

</mapper>
