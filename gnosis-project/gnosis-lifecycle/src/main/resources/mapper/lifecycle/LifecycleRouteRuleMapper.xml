<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lifecycle.repository.LifecycleRouteRuleMapper">

    <resultMap id="BaseResultMap" type="lifecycle.domain.LifecycleRouteRule">
        <id column="id" property="id"/>
        <result column="business_type_id" property="businessTypeId"/>
        <result column="event_type" property="eventType"/>
        <result column="rule_name" property="ruleName"/>
        <result column="condition_expression" property="conditionExpression"/>
        <result column="priority" property="priority"/>
        <result column="is_active" property="isActive"/>
        <result column="version" property="version"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, business_type_id, event_type, rule_name, condition_expression, priority, is_active, version,
        create_user_id, update_user_id, create_time, update_time
    </sql>

    <select id="selectById" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lifecycle_route_rule
        WHERE id = #{id}
    </select>

    <select id="selectList" parameterType="lifecycle.domain.LifecycleRouteRule" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lifecycle_route_rule
        <where>
            <if test="businessTypeId != null and businessTypeId != ''">
                AND business_type_id = #{businessTypeId}
            </if>
            <if test="eventType != null and eventType != ''">
                AND event_type = #{eventType}
            </if>
            <if test="ruleName != null and ruleName != ''">
                AND rule_name LIKE CONCAT('%', #{ruleName}, '%')
            </if>
            <if test="isActive != null">
                AND is_active = #{isActive}
            </if>
        </where>
        ORDER BY priority DESC, version DESC, create_time DESC
    </select>

    <insert id="insert" parameterType="lifecycle.domain.LifecycleRouteRule">
        INSERT INTO lifecycle_route_rule (
            id, business_type_id, event_type, rule_name, condition_expression,
            priority, is_active, version,
            create_user_id, update_user_id, create_time, update_time
        ) VALUES (
            #{id}, #{businessTypeId}, #{eventType}, #{ruleName}, #{conditionExpression},
            #{priority}, #{isActive}, #{version},
            #{createUserId}, #{updateUserId}, #{createTime}, #{updateTime}
        )
    </insert>

    <update id="updateById" parameterType="lifecycle.domain.LifecycleRouteRule">
        UPDATE lifecycle_route_rule
        <set>
            <if test="ruleName != null and ruleName != ''">
                rule_name = #{ruleName},
            </if>
            <if test="conditionExpression != null">
                condition_expression = #{conditionExpression},
            </if>
            <if test="priority != null">
                priority = #{priority},
            </if>
            <if test="isActive != null">
                is_active = #{isActive},
            </if>
            <if test="version != null">
                version = #{version},
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                update_user_id = #{updateUserId},
            </if>
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.String">
        DELETE FROM lifecycle_route_rule WHERE id = #{id}
    </delete>

    <delete id="deleteByIds" parameterType="java.lang.String">
        DELETE FROM lifecycle_route_rule WHERE id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
