<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gnosis.notice.mapper.NoticeGroupMapper">

    <resultMap id="BaseResultMap" type="com.gnosis.notice.domain.NoticeGroup">
        <id column="id" property="id"/>
        <result column="group_code" property="groupCode"/>
        <result column="group_name" property="groupName"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, group_code, group_name, description, status,
        create_user_id, update_user_id, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.gnosis.notice.domain.NoticeGroup">
        INSERT INTO sys_notice_group (
            id, group_code, group_name, description, status,
            create_user_id, update_user_id, create_time, update_time
        ) VALUES (
            #{id}, #{groupCode}, #{groupName}, #{description}, #{status},
            #{createUserId}, #{updateUserId}, #{createTime}, #{updateTime}
        )
    </insert>

    <update id="updateById" parameterType="com.gnosis.notice.domain.NoticeGroup">
        UPDATE sys_notice_group
        <set>
            <if test="groupCode != null">group_code = #{groupCode},</if>
            <if test="groupName != null">group_name = #{groupName},</if>
            <if test="description != null">description = #{description},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateUserId != null">update_user_id = #{updateUserId},</if>
            update_time = #{updateTime}
        </set>
        WHERE id = #{id}
    </update>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_notice_group
        WHERE id = #{id}
    </select>

    <select id="selectByCode" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_notice_group
        WHERE group_code = #{groupCode}
    </select>

    <select id="selectByCondition" resultMap="BaseResultMap" parameterType="com.gnosis.notice.dto.group.NoticeGroupQueryRequest">
        SELECT <include refid="Base_Column_List"/>
        FROM sys_notice_group
        <where>
            <if test="groupCode != null and groupCode != ''">AND group_code = #{groupCode}</if>
            <if test="groupName != null and groupName != ''">AND group_name LIKE CONCAT('%', #{groupName}, '%')</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY create_time DESC
        <if test="pageNum != null and pageSize != null">
            LIMIT #{pageSize} OFFSET #{pageNum}
        </if>
    </select>

    <select id="countByCondition" resultType="java.lang.Long" parameterType="com.gnosis.notice.dto.group.NoticeGroupQueryRequest">
        SELECT COUNT(*) FROM sys_notice_group
        <where>
            <if test="groupCode != null and groupCode != ''">AND group_code = #{groupCode}</if>
            <if test="groupName != null and groupName != ''">AND group_name LIKE CONCAT('%', #{groupName}, '%')</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
    </select>

    <delete id="deleteById">
        DELETE FROM sys_notice_group WHERE id = #{id}
    </delete>

    <delete id="deleteByIds">
        DELETE FROM sys_notice_group WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <update id="batchUpdateStatus">
        UPDATE sys_notice_group
        SET status = #{status}, update_time = CURRENT_TIMESTAMP
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </update>

</mapper>
