<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="openplat.mapper.OpenplatApiDocMapper">
    
    <resultMap id="BaseResultMap" type="openplat.domain.OpenplatApiDoc">
        <id column="id" property="id"/>
        <result column="api_id" property="apiId"/>
        <result column="doc_title" property="docTitle"/>
        <result column="doc_content" property="docContent"/>
        <result column="request_params" property="requestParams"/>
        <result column="response_params" property="responseParams"/>
        <result column="error_codes" property="errorCodes"/>
        <result column="version" property="version"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    
    <sql id="Base_Column_List">
        id, api_id, doc_title, doc_content, request_params, response_params, error_codes,
        version, create_user_id, create_time, update_user_id, update_time
    </sql>
    
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM openplat_api_doc
        WHERE id = #{id}
    </select>
    
    <select id="selectByApiId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM openplat_api_doc
        WHERE api_id = #{apiId}
    </select>
    
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM openplat_api_doc
        <where>
            <if test="apiId != null and apiId != ''">
                AND api_id = #{apiId}
            </if>
            <if test="docTitle != null and docTitle != ''">
                AND doc_title LIKE CONCAT('%', #{docTitle}, '%')
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
    
    <insert id="insert" parameterType="openplat.domain.OpenplatApiDoc">
        INSERT INTO openplat_api_doc (
            id, api_id, doc_title, doc_content, request_params, response_params, error_codes,
            version, create_user_id, create_time, update_user_id, update_time
        ) VALUES (
            #{id}, #{apiId}, #{docTitle}, #{docContent}, #{requestParams}, #{responseParams}, #{errorCodes},
            #{version}, #{createUserId}, #{createTime}, #{updateUserId}, #{updateTime}
        )
    </insert>
    
    <update id="update" parameterType="openplat.domain.OpenplatApiDoc">
        UPDATE openplat_api_doc
        <set>
            <if test="docTitle != null and docTitle != ''">doc_title = #{docTitle},</if>
            <if test="docContent != null">doc_content = #{docContent},</if>
            <if test="requestParams != null">request_params = #{requestParams},</if>
            <if test="responseParams != null">response_params = #{responseParams},</if>
            <if test="errorCodes != null">error_codes = #{errorCodes},</if>
            <if test="version != null">version = #{version},</if>
            <if test="updateUserId != null">update_user_id = #{updateUserId},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM openplat_api_doc WHERE id = #{id}
    </delete>
    
    <delete id="deleteByIds">
        DELETE FROM openplat_api_doc WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>
