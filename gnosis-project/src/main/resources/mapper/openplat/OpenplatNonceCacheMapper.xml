<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="openplat.mapper.OpenplatNonceCacheMapper">
    
    <resultMap id="BaseResultMap" type="openplat.domain.OpenplatNonceCache">
        <id column="id" property="id"/>
        <result column="app_id" property="appId"/>
        <result column="nonce" property="nonce"/>
        <result column="expire_time" property="expireTime"/>
        <result column="create_time" property="createTime"/>
    </resultMap>
    
    <sql id="Base_Column_List">
        id, app_id, nonce, expire_time, create_time
    </sql>
    
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM openplat_nonce_cache
        WHERE id = #{id}
    </select>
    
    <select id="selectByAppIdAndNonce" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM openplat_nonce_cache
        WHERE app_id = #{appId} AND nonce = #{nonce}
    </select>
    
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM openplat_nonce_cache
        <where>
            <if test="appId != null and appId != ''">
                AND app_id = #{appId}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
    
    <insert id="insert" parameterType="openplat.domain.OpenplatNonceCache">
        INSERT INTO openplat_nonce_cache (
            id, app_id, nonce, expire_time, create_time
        ) VALUES (
            #{id}, #{appId}, #{nonce}, #{expireTime}, #{createTime}
        )
    </insert>
    
    <delete id="deleteById">
        DELETE FROM openplat_nonce_cache WHERE id = #{id}
    </delete>
    
    <delete id="deleteByIds">
        DELETE FROM openplat_nonce_cache WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
    <delete id="deleteExpired">
        DELETE FROM openplat_nonce_cache WHERE expire_time &lt; #{expireTime}
    </delete>
    
</mapper>
