<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="lifecycle.repository.LifecycleEventMapper">

    <resultMap id="BaseResultMap" type="lifecycle.domain.LifecycleEvent">
        <id column="id" property="id"/>
        <result column="business_type_id" property="businessTypeId"/>
        <result column="business_id" property="businessId"/>
        <result column="event_type" property="eventType"/>
        <result column="event_data" property="eventData"/>
        <result column="metadata_snapshot" property="metadataSnapshot"/>
        <result column="source_system" property="sourceSystem"/>
        <result column="status" property="status"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, business_type_id, business_id, event_type, event_data, metadata_snapshot, source_system, status,
        create_user_id, update_user_id, create_time, update_time
    </sql>

    <select id="selectById" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lifecycle_event
        WHERE id = #{id}
    </select>

    <select id="selectList" parameterType="lifecycle.domain.LifecycleEvent" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM lifecycle_event
        <where>
            <if test="businessTypeId != null and businessTypeId != ''">
                AND business_type_id = #{businessTypeId}
            </if>
            <if test="businessId != null and businessId != ''">
                AND business_id = #{businessId}
            </if>
            <if test="eventType != null and eventType != ''">
                AND event_type = #{eventType}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="sourceSystem != null and sourceSystem != ''">
                AND source_system = #{sourceSystem}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <insert id="insert" parameterType="lifecycle.domain.LifecycleEvent">
        INSERT INTO lifecycle_event (
            id, business_type_id, business_id, event_type, event_data, metadata_snapshot,
            source_system, status,
            create_user_id, update_user_id, create_time, update_time
        ) VALUES (
            #{id}, #{businessTypeId}, #{businessId}, #{eventType}, #{eventData}, #{metadataSnapshot},
            #{sourceSystem}, #{status},
            #{createUserId}, #{updateUserId}, #{createTime}, #{updateTime}
        )
    </insert>

    <update id="updateById" parameterType="lifecycle.domain.LifecycleEvent">
        UPDATE lifecycle_event
        <set>
            <if test="eventData != null">
                event_data = #{eventData},
            </if>
            <if test="metadataSnapshot != null">
                metadata_snapshot = #{metadataSnapshot},
            </if>
            <if test="status != null and status != ''">
                status = #{status},
            </if>
            <if test="updateUserId != null and updateUserId != ''">
                update_user_id = #{updateUserId},
            </if>
            update_time = CURRENT_TIMESTAMP
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="java.lang.String">
        DELETE FROM lifecycle_event WHERE id = #{id}
    </delete>

    <delete id="deleteByIds" parameterType="java.lang.String">
        DELETE FROM lifecycle_event WHERE id IN
        <foreach collection="array" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
