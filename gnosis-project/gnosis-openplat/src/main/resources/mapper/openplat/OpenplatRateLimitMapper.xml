<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="openplat.mapper.OpenplatRateLimitMapper">
    
    <resultMap id="BaseResultMap" type="openplat.domain.OpenplatRateLimit">
        <id column="id" property="id"/>
        <result column="limit_name" property="limitName"/>
        <result column="limit_type" property="limitType"/>
        <result column="limit_key" property="limitKey"/>
        <result column="rate_limit" property="rateLimit"/>
        <result column="burst_limit" property="burstLimit"/>
        <result column="window_size" property="windowSize"/>
        <result column="status" property="status"/>
        <result column="description" property="description"/>
        <result column="create_user_id" property="createUserId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_user_id" property="updateUserId"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>
    
    <sql id="Base_Column_List">
        id, limit_name, limit_type, limit_key, rate_limit, burst_limit, window_size,
        status, description, create_user_id, create_time, update_user_id, update_time
    </sql>
    
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM openplat_rate_limit
        WHERE id = #{id}
    </select>
    
    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM openplat_rate_limit
        <where>
            <if test="limitName != null and limitName != ''">
                AND limit_name LIKE CONCAT('%', #{limitName}, '%')
            </if>
            <if test="limitType != null and limitType != ''">
                AND limit_type = #{limitType}
            </if>
            <if test="limitKey != null and limitKey != ''">
                AND limit_key LIKE CONCAT('%', #{limitKey}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY create_time DESC
    </select>
    
    <insert id="insert" parameterType="openplat.domain.OpenplatRateLimit">
        INSERT INTO openplat_rate_limit (
            id, limit_name, limit_type, limit_key, rate_limit, burst_limit, window_size,
            status, description, create_user_id, create_time, update_user_id, update_time
        ) VALUES (
            #{id}, #{limitName}, #{limitType}, #{limitKey}, #{rateLimit}, #{burstLimit}, #{windowSize},
            #{status}, #{description}, #{createUserId}, #{createTime}, #{updateUserId}, #{updateTime}
        )
    </insert>
    
    <update id="update" parameterType="openplat.domain.OpenplatRateLimit">
        UPDATE openplat_rate_limit
        <set>
            <if test="limitName != null and limitName != ''">limit_name = #{limitName},</if>
            <if test="limitType != null and limitType != ''">limit_type = #{limitType},</if>
            <if test="limitKey != null and limitKey != ''">limit_key = #{limitKey},</if>
            <if test="rateLimit != null">rate_limit = #{rateLimit},</if>
            <if test="burstLimit != null">burst_limit = #{burstLimit},</if>
            <if test="windowSize != null">window_size = #{windowSize},</if>
            <if test="status != null">status = #{status},</if>
            <if test="description != null">description = #{description},</if>
            <if test="updateUserId != null">update_user_id = #{updateUserId},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM openplat_rate_limit WHERE id = #{id}
    </delete>
    
    <delete id="deleteByIds">
        DELETE FROM openplat_rate_limit WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
    
</mapper>
